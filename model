def weighted_loss(y_true, y_pred, borda_weights):
    y_true = tf.cast(y_true, tf.int32)
    weights = tf.cast(tf.gather(borda_weights, y_true), tf.float32)
    loss = tf.keras.losses.sparse_categorical_crossentropy(y_true, y_pred)
    weighted_loss = loss * weights
    return tf.reduce_mean(weighted_loss)

class WeightedLayer(tf.keras.layers.Layer):
    def __init__(self, weight_tensor, **kwargs):
        super(WeightedLayer, self).__init__(**kwargs)
        self.weight_tensor = tf.Variable(weight_tensor, name="weights", trainable=True)

    def call(self, inputs):
        return inputs * self.weight_tensor

def build_parallel_cnn_gru_model(input_shape_cnn, input_shape_gru, borda_weights_normalized):
    input_layer_cnn = tf.keras.Input(shape=input_shape_cnn)
    borda_weights_normalized = tf.cast(borda_weights_normalized, dtype=tf.float32)

    weight_cnn = tf.expand_dims(tf.expand_dims(borda_weights_normalized, axis=0), axis=-1)
    cnn_branch = WeightedLayer(weight_cnn)(input_layer_cnn)

    cnn_branch = layers.Conv2D(64, (3, 3), activation='relu', padding='same')(cnn_branch)
    cnn_branch = layers.MaxPooling2D((2, 2), padding='same')(cnn_branch)
    cnn_branch = layers.Conv2D(128, (3, 3), activation='relu', padding='same')(cnn_branch)
    cnn_branch = layers.MaxPooling2D((2, 2), padding='same')(cnn_branch)
    cnn_branch = layers.Conv2D(256, (3, 3), activation='relu', padding='same')(cnn_branch)
    cnn_branch = layers.MaxPooling2D((2, 2), padding='same')(cnn_branch)
    cnn_branch = layers.Flatten()(cnn_branch)

    input_layer_gru = tf.keras.Input(shape=input_shape_gru)

    weight_gru = tf.expand_dims(borda_weights_normalized, axis=-1)
    gru_branch = WeightedLayer(weight_gru)(input_layer_gru)

    gru_branch = layers.GRU(16, return_sequences=True)(gru_branch)
    gru_branch = layers.Dropout(0.2)(gru_branch)
    gru_branch = layers.GRU(32, return_sequences=True)(gru_branch)
    gru_branch = layers.Dropout(0.2)(gru_branch)
    gru_branch = layers.GRU(64, return_sequences=False)(gru_branch)

    bilinear = tf.keras.layers.Lambda(lambda tensors: tf.einsum('bi,bj->bij', tensors[0], tensors[1]))(
        [cnn_branch, gru_branch]
    )
    bilinear = layers.Flatten()(bilinear)

    dense = layers.Dense(128, activation='relu')(bilinear)
    dropout = layers.Dropout(0.5)(dense)
    output = layers.Dense(6, activation='softmax')(dropout)

    model = tf.keras.Model(inputs=[input_layer_cnn, input_layer_gru], outputs=output)
    return model

class TqdmEpochProgress(tf.keras.callbacks.Callback):
    def __init__(self, epochs):
        self.epochs = epochs
        self.progress_bar = tqdm(total=epochs, desc="Training Progress", unit="epoch")

    def on_epoch_end(self, epoch, logs=None):
        self.progress_bar.set_postfix({
            "loss": logs.get("loss"),
            "accuracy": logs.get("accuracy"),
            "val_loss": logs.get("val_loss"),
            "val_accuracy": logs.get("val_accuracy"),
        })
        self.progress_bar.update(1)

    def on_train_end(self, logs=None):
        self.progress_bar.close()

